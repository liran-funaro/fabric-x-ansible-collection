{% if loadgen_use_mock_orderer %}
# ---------------------------------------------------------------------------
# Sidecar Client Settings
# ---------------------------------------------------------------------------
# The presence of this section selects the sidecar adapter, which replaces the
# ordering service with a mock orderer embedded in this loadgen process. Blocks are
# cut here and served straight to the committer sidecar, so the committer can be
# measured without an ordering service in the path.
#
# The mock orderer serves the genesis config block, and signs the blocks it cuts,
# using the material under load-profile.policy.artifacts-path. The sidecar verifies
# those blocks against the orderer organization carried in that same config block.
sidecar-client:
{% include './sections/sidecar-client.yaml.j2' %}
  # Addresses the embedded mock orderer listens on, one gRPC server per orderer party.
  # These have to match the endpoints advertised in the config block, or the sidecar
  # dials an address nothing is serving.
  #
  # Plaintext by design: the sidecar takes the CA certificates for its orderer
  # connection from the config block, and the orderer TLS certificate generated with
  # the artifacts does not carry this host in its subject alternative names, so server
  # verification could not succeed. This link exists only to feed the committer under
  # test, and carries the same transactions the loadgen already generates locally.
  orderer-servers:
    - endpoint: 0.0.0.0:{{ loadgen_mock_orderer_port }}
{% else %}
# ---------------------------------------------------------------------------
# Orderer Client Settings
# ---------------------------------------------------------------------------
orderer-client:
  # Number of parallel goroutines for broadcasting transactions to the orderer.
  # Higher values increase throughput but consume more resources.
  # We set low values to reduce the CPU load during tests.
  broadcast-parallelism: {{ loadgen_broadcast_parallelism | default(ansible_facts.processor_vcpus | int // 4) }}
  # Direct orderer connection configuration (alternative to sidecar-client)
  orderer:
    # Fault tolerance level of the ordering service: 'BFT' (Byzantine Fault Tolerant) or 'CFT'.
    # Affects how the loadgen interacts with the orderer.
    fault-tolerance-level: {{ loadgen_orderer_fault_tolerance_level | default('BFT') }}
    # Path to the latest known config block file, used to obtain the latest endpoints and TLS credentials
    # of the Orderer parties.
    latest-known-config-block-path: {{ loadgen_config_dir }}/{{ loadgen_config_block_file }}
{% if (hostvars[orderer_ref_host].orderer_use_tls is defined) and hostvars[orderer_ref_host].orderer_use_tls %}
    # Loadgen uses these TLS credentials when connecting to the orderers as a client.
    tls:
      # Path to the client's TLS private key file.
      key-path: {{ loadgen_config_dir }}/tls/server.key
      # Path to the client's TLS certificate file (public key) for authentication.
      cert-path: {{ loadgen_config_dir }}/tls/server.crt
{% if (hostvars[orderer_ref_host].orderer_use_mtls is defined) and hostvars[orderer_ref_host].orderer_use_mtls %}
      # TLS mode for orderer client connections.
      mode: mtls
{% else %}
      # TLS mode for orderer client connections.
      mode: tls
{% endif %}
{% endif %}
    # Identity configuration for signing transactions and connecting to orderers.
    identity:
      # MSP (Membership Service Provider) ID identifying the organization.
      msp-id: {{ organization.name }}MSP
      # Path to the MSP directory containing certificates and keys.
      # Standard Fabric MSP structure with signcerts/, keystore/, cacerts/, etc.
      msp-dir: {{ loadgen_config_dir }}/msp
      # BCCSP (Blockchain Crypto Service Provider) configuration for cryptographic operations.
      bccsp:
        # Default crypto provider: 'SW' (software) or 'PKCS11' (hardware security module).
        Default: SW
        SW:
          # Security level in bits (256 for ECDSA P-256, 384 for P-384).
          Security: 256
          # Hash algorithm: 'SHA2' or 'SHA3'.
          Hash: SHA2
{% include './sections/sidecar-client.yaml.j2' %}
{% endif %}

{% if loadgen_queries_rate is defined and (loadgen_queries_rate | float) > 0 %}
# ---------------------------------------------------------------------------
# Query Service Client Settings
# ---------------------------------------------------------------------------
# Connection used to fetch committed read versions for the subset of each transaction's reads
# selected by load-profile.transaction.queries-rate. One load-balanced connection is dialed per
# worker, round-robining across the endpoints below. Required whenever queries-rate > 0.
query-client:
  # Query-service endpoints. List several instances to spread the query load.
  endpoints:
{% for query_host in committer_query_service_hosts %}
    - {{ hostvars[query_host].ansible_host }}:{{ hostvars[query_host].committer_rpc_port }}
{% endfor %}
{% if (hostvars[committer_query_service_hosts | first].committer_use_tls is defined) and hostvars[committer_query_service_hosts | first].committer_use_tls %}
  # TLS credentials used when connecting to the query service.
  tls:
    # List of paths to CA certificate files for verifying server certificates.
    ca-cert-paths:
      - {{ loadgen_config_dir }}/tls/query/ca.crt
{% if (hostvars[committer_query_service_hosts | first].committer_use_mtls is defined) and hostvars[committer_query_service_hosts | first].committer_use_mtls %}
    # Path to the client's TLS private key file.
    key-path: {{ loadgen_config_dir }}/tls/server.key
    # Path to the client's TLS certificate file (public key) for authentication.
    cert-path: {{ loadgen_config_dir }}/tls/server.crt
    # TLS mode for query-service connections.
    mode: mtls
{% else %}
    # TLS mode for query-service connections.
    mode: tls
{% endif %}
{% endif %}
{% endif %}

